# Plantilla de variables de la API. Copiar a `.env.local` (ignorado por git)
# y llenar a mano desde el panel de Supabase. Aquí nunca van valores reales.
#
# Sólo servidor: no llevan prefijo NEXT_PUBLIC_, así que Next no las envía al
# navegador. No copiarlas del front ni de Vercel sin revisar qué son.

# Project Settings → Data API → Project URL. Sólo el origen, sin ruta.
# Ej.: https://<ref>.supabase.co  (o http://127.0.0.1:54321 con Supabase local)
SUPABASE_URL=

# Project Settings → API Keys → Publishable key (sb_publishable_…).
# También se acepta la clave "anon" antigua. Respeta RLS: no da permisos extra.
# NUNCA la secret key (sb_secret_…) ni service_role: la API las rechaza.
SUPABASE_PUBLISHABLE_KEY=
